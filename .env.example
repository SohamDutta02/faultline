# one key is enough; the model id picks the provider (gemini-*, claude-*, gpt-*/o*,
# anything else = an OpenAI-compatible server at OPENAI_BASE_URL)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# a model you serve yourself: vLLM, SGLang, Ollama, llama.cpp, OpenRouter... (no key needed locally)
OPENAI_BASE_URL=
# default model for sweeps and the web app; empty = the first provider with a key, at its default
FAULTLINE_MODEL=
# force a provider when the model id doesn't say (e.g. a gpt-named model on your own server)
FAULTLINE_PROVIDER=

# only needed when running the servers yourself instead of passing --serve
TOOLSERVER_URL=http://127.0.0.1:8100
PROXY_URL=http://127.0.0.1:8200
