# Copy to .env in the repository root (next to compose.yaml) and fill in.

# The address people will type, e.g. faultline.yourdomain.com. Its DNS A record
# must point at this server before starting, so Caddy can get a certificate.
DOMAIN=faultline.example.com

# Login for the site. Make the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# and paste it inside SINGLE quotes (the hash contains $ signs).
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH='$2a$14$replace.with.the.output.of.caddy.hash-password'

# Optional: enables the model-driven architectures (single, retry, critic).
GEMINI_API_KEY=
FAULTLINE_MODEL=gemini-2.0-flash
